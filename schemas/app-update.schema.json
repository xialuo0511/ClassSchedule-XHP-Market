{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xialuo0511/ClassSchedule-XHP-Market/main/schemas/app-update.schema.json",
  "title": "ClassSchedule App Update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versionCode",
    "versionName",
    "publishedAt",
    "mandatory",
    "downloadUrl",
    "sha256",
    "releaseNotes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mandatory": {
      "type": "boolean"
    },
    "downloadUrl": {
      "type": "string",
      "format": "uri"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["versionCode", "versionName", "publishedAt", "notes"],
        "properties": {
          "versionCode": {
            "type": "integer",
            "minimum": 1
          },
          "versionName": {
            "type": "string",
            "minLength": 1
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
